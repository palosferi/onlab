# Copy to the repository root as .env.collection and edit.
# run_round.sh sources it automatically.

TOR_WF_HOST_LABEL=fujitsu-server
# Leave unset to auto-detect from the default route.
#TOR_WF_INTERFACE=enp3s0

TOR_WF_COLLECT_BASELINE=1
TOR_WF_COLLECT_OBFS4=1
TOR_WF_BASELINE_SOCKS_PORT=9050
TOR_WF_BASELINE_CONTROL_PORT=9051
TOR_WF_OBFS4_SOCKS_PORT=9052
TOR_WF_OBFS4_CONTROL_PORT=9053

# Snowflake. Off by default: it needs lyrebird from fetch_pt_bundle.sh, and it
# roughly doubles a round's duration because pages load more slowly over it.
TOR_WF_COLLECT_SNOWFLAKE=0
TOR_WF_SNOWFLAKE_SOCKS_PORT=9064
TOR_WF_SNOWFLAKE_CONTROL_PORT=9065

# Identical to the spring 2026 collection. Do not change mid-study.
TOR_WF_CAPTURE_DURATION=15
TOR_WF_WARMUP_DURATION=3
TOR_WF_REPEATS=8

# Off by default to stay comparable with the spring t0. See collect_round.py.
TOR_WF_REMOTE_DNS=0
