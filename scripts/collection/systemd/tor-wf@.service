[Unit]
Description=Tor WF collection instance (%i)
Documentation=file://%h/onlab/docs/LONGITUDINAL_SETUP.md
After=network-online.target
Wants=network-online.target

[Service]
# The generated torrc sets RunAsDaemon 1, so tor forks and writes its own
# PID file.
Type=forking
PIDFile=%h/tor_wf_runtime/%i/tor.pid
# The tor from the Tor Expert Bundle (fetch_pt_bundle.sh), the version Tor
# Browser ships, rather than the distribution's.
Environment=LD_LIBRARY_PATH=%h/tor_wf_runtime/pt/tor
ExecStart=%h/tor_wf_runtime/pt/tor/tor -f %h/tor_wf_runtime/%i/torrc
# A Tor that dies mid-study silently costs a week of data, so restart it.
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
