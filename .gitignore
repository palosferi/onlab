# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments
.venv/
venv/
env/

# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# Local editor/system files
.DS_Store
*.swp
*.swo

# Build/package artifacts
build/
dist/
*.egg-info/

# Local datasets and generated data artifacts, all of it. The provenance files
# (manifest.csv, round_meta.json, run_*.json) used to be let through, but each of
# them records the private obfs4 bridge's IP and fingerprint for the obfs4 arm.
tor_dataset/
tor_dataset_release_2026-06-01/

# Collection host configuration (may contain a bridge line)
.env.collection

# Generated figures (keep curated figures manually if needed)
figures/*.png
figures/*.jpg
figures/*.jpeg
figures/*.pdf
figures/*.svg
figures/*.eps

# Logs and local outputs
logs/
*.log
*.jsonl

# LaTeX build artifacts (keep .tex and generated .pdf)
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.out
*.synctex.gz
*.synctex(busy)
*.toc

# LaTeX editor backups
*~

# Coverage outputs
.coverage
coverage.xml
htmlcov/
*.cover

# Leftover from a failed git migration
.git.BROKEN-migration/
